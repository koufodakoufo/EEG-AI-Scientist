# Current source is identical across Windows and Linux.
*.py text eol=lf
*.sh text eol=lf
*.toml text eol=lf
*.ps1 text eol=crlf
*.md text eol=lf
*.json text eol=lf

# Historical records retain their exact source bytes.
/docs/history/** -text whitespace=cr-at-eol
/archive/** -text whitespace=cr-at-eol
